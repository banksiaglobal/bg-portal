/// Every slot an extension can contribute to, derived from code: the shell's, the
/// built-in per-page ones of every concrete Portal.Page subclass (columns/actions/
/// bulk-actions on lists, fields on edit pages) and the widget slots each page declares
/// with <ext-slot> in its template. Each entry carries the item schema of its kind
/// (Portal.Ext.Schema). Shown on Portal.Extensions.cls as the extension points
/// reference; Markdown() renders the same reference as text.
Class Portal.Ext.Slots Extends %RegisteredObject
{

/// [{id, kind: items|columns|actions|bulk-actions|fields|widgets, page, description,
///   schema: {keys: {key: {type, required, enum, doc}}, example}}]
ClassMethod Slots() As %DynamicArray
{
    set out = ..Bare()
    set iter = out.%GetIterator()
    while iter.%GetNext(.i, .slot) {
        set slot.schema = ##class(Portal.Ext.Schema).ForSlot(slot.id)
    }
    return out
}

/// The slot list without schemas: shell slots, then every concrete Portal.Page subclass
/// with a PAGEID, whatever package it lives in (extensions ship pages too).
ClassMethod Bare() As %DynamicArray
{
    set out = [
        {"id": "shell.nav", "kind": "items", "page": "", "description": "Sidebar navigation entries; `group` places them under a heading."},
        {"id": "shell.topbar", "kind": "items", "page": "", "description": "Links in the top bar, left of the user menu."},
        {"id": "shell.user-menu", "kind": "items", "page": "", "description": "Entries in the user menu."},
        {"id": "shell.footer", "kind": "items", "page": "", "description": "Footer links or text."},
        {"id": "shell.head", "kind": "head", "page": "", "description": "Stylesheet or script content written into every page's <head> (<link>/<style>/<script>); `page` scopes an item to one PAGEID."}
    ]
    set rs = ##class(%ResultSet).%New("%Dictionary.ClassDefinitionQuery:SubclassOf")
    do rs.Execute("Portal.Page")
    while rs.%Next() {
        set class = rs.Get("Name")
        set def = ##class(%Dictionary.CompiledClass).%OpenId(class)
        continue:'$isobject(def)
        continue:def.Abstract
        set pageId = $parameter(class, "PAGEID")
        continue:pageId=""
        set pages(pageId) = class
    }
    set pageId = ""
    for {
        set pageId = $order(pages(pageId), 1, class)
        quit:pageId=""
        if $classmethod(class, "%Extends", "Portal.ListPage") {
            do out.%Push({"id": ("page." _ pageId _ ".columns"), "kind": "columns", "page": (class), "description": "Extra table columns, computed server-side or rendered by a component."})
            do out.%Push({"id": ("page." _ pageId _ ".actions"), "kind": "actions", "page": (class), "description": "Row buttons: navigate to a URL or run a server method on the row."})
            do out.%Push({"id": ("page." _ pageId _ ".bulk-actions"), "kind": "bulk-actions", "page": (class), "description": "Toolbar buttons that run a server method on the selected rows."})
        }
        if $classmethod(class, "%Extends", "Portal.EditPage") {
            do out.%Push({"id": ("page." _ pageId _ ".fields"), "kind": "fields", "page": (class), "description": "Extra inputs on the form, persisted by the extension."})
        }
        set slots = $classmethod(class, "WidgetSlots")
        set ptr = 0
        while $listnext(slots, ptr, slot) {
            do out.%Push({"id": (slot), "kind": "widgets", "page": (class), "description": ("Widget cards in <ext-slot name=""" _ $piece(slot, ".", *) _ """> of " _ class _ ".")})
        }
    }
    return out
}

/// The reference as Markdown: one section per slot with its keys (type, required,
/// allowed values), and a one-line JSON example. The authoritative list; docs link here
/// rather than pasting it.
ClassMethod Markdown() As %String
{
    set nl = $char(10)
    set md = "# Extension points" _ nl _ nl _ "Generated by `##class(Portal.Ext.Slots).Markdown()` on " _ $zdatetime($horolog, 3) _ ". Every item may also carry `" _ $replace(##class(Portal.Ext.Schema).#COMMON, ",", "`, `") _ "`." _ nl
    set slots = ..Slots()
    set iter = slots.%GetIterator()
    while iter.%GetNext(.i, .slot) {
        set md = md _ nl _ "## `" _ slot.id _ "`" _ nl _ nl
        set md = md _ slot.description _ " Kind: `" _ slot.kind _ "`" _ $select(slot.page '= "": ", page `" _ slot.page _ "`.", 1: ".") _ nl _ nl
        continue:'$isobject(slot.schema)
        set md = md _ "| Key | Type | Required | Values | Notes |" _ nl _ "|---|---|---|---|---|" _ nl
        set keys = slot.schema.keys.%GetIterator()
        while keys.%GetNext(.key, .spec) {
            set values = ""
            if $isobject(spec.enum) {
                set e = spec.enum.%GetIterator()
                while e.%GetNext(.j, .v) { set values = values _ $select(values = "": "", 1: ", ") _ "`" _ v _ "`" }
            }
            set md = md _ "| `" _ key _ "` | " _ spec.type _ " | " _ $select(spec.required: "yes", 1: "") _ " | " _ values _ " | " _ spec.doc _ " |" _ nl
        }
        set md = md _ nl _ "Example: `" _ slot.schema.example.%ToJSON() _ "`" _ nl
    }
    return md
}

/// Slots with the number of items currently contributed to each (as seen by this user).
ClassMethod WithCounts() As %DynamicArray
{
    set slots = ..Slots()
    set iter = slots.%GetIterator()
    while iter.%GetNext(.i, .slot) {
        set slot.count = ##class(Portal.Ext.Registry).Collect(slot.id).%Size()
    }
    return slots
}

}
